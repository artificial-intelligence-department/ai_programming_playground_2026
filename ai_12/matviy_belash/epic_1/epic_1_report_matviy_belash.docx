iagw f1vx9l62 fnkimw8 f70vs8p f1jh79k8 tile" bis_skin_checked="1"><div class="___cgrxe20 f10pi13n f22iagw f1vx9l62" bis_skin_checked="1"><button role="button" type="button" class="fui-Link ___1j59c1l f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fkhj508 figsok6 fja3aga f1mk8lai f1a3p1vp f1o700av f1iuv45f f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f10pi13n fmvc45e fm9niy f3nvo6x f1y74qym" data-carousel-tile-thumbnail="" aria-label="Похвальная грамота" aria-describedby="fui-r44"><div bis_skin_checked="1" style="aspect-ratio: 1.41343 / 1; height: 14rem;"><img alt="Похвальная грамота vintage-botanical" class="___2k7zy00 f1kle4es f1aehjj5 f1euv43f f15twtuk f1vgc2s3 fly5x3f f1l02sjl" src="./Word в Интернете — Microsoft 365_files/%D0%BF%D0%BE%D1%85%D0%B2%D0%B0%D0%BB%D1%8C%D0%BD%D0%B0%D1%8F-%D0%B3%D1%80%D0%B0%D0%BC%D0%BE%D1%82%D0%B0-vintage-botanical-0-1-e2c6629d5315.webp" loading="lazy"></div></button><div id="previewEditButtonsStyle" class="___1rtvkjo f1euv43f fjseox f1wswh21 f1e31b4d f1x0mjh4" bis_skin_checked="1"><div class="___1v9u7h9 f22iagw f6jr5hl f1czfa6m f1acs6jw f1e53v91 f8vbe74 fni485r f69kmt0 f1kd9ml8" bis_skin_checked="1"><button type="button" id="editTemplateButton-206be728-a839-42c4-853a-2a09077b273f" class="fui-Button r1f29ykk ___1y38iaw f1aapu2g fq1bxqj fgfkb25 fxxax6y f1043qnm f52wu7l f6i9fuv f1gu5o86 fnwkoal f1f0uunu fkw6ri2 f2a8moe f1eghkp3 f3nvo6x" aria-label="Изменить">Изменить</button></div></div></div><div class="___12vb27g fjseox" id="fui-r44" bis_skin_checked="1">Используйте эту похвальную грамоту, чтобы отметить заслуги человека, завершившего сложный проект. Изящное цветочное оформление грамоты включает три сочетания цветов. Вы можете легко изменить шаблон в Word, чтобы настроить его дизайн. Это шаблон с поддержкой специальных возможностей. 
</div><div role="status" aria-live="polite" aria-atomic="true" class="___1tz03sw fyxfkj9 f1wch0ki fx1dtu3 f136euu9 f1a3p1vp f1mk8lai f1euv43f f1ff8sh1 fz5stix" bis_skin_checked="1"></div></div></div><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><div role="group" tabindex="0" id="card-12" aria-label="Простое резюме для дизайнера и разработчика UI/UX, 13 из 20" aria-roledescription="slide" class="fui-CarouselCard ___1yqcwr5 fd9q35j f6dzj5z fy77jfu f14z66ap ftqa4ok fxh72wf f101ogj7 f1fgzgb1 f1ej52l8" data-tabster="{&quot;groupper&quot;:{&quot;tabbability&quot;:1},&quot;focusable&quot;:{&quot;isDefault&quot;:false}}" bis_skin_checked="1"><div class="___dvqppc0 f10pi13n fly5x3f f1gl81tg f22iagw f1vx9l62 fnkimw8 f70vs8p f1jh79k8 tile" bis_skin_checked="1"><div class="___cgrxe20 f10pi13n f22iagw f1vx9l62" bis_skin_checked="1"><button role="button" type="button" class="fui-Link ___1j59c1l f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fkhj508 figsok6 fja3aga f1mk8lai f1a3p1vp f1o700av f1iuv45f f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f10pi13n fmvc45e fm9niy f3nvo6x f1y74qym" data-carousel-tile-thumbnail="" aria-label="Простое резюме для дизайнера и разработчика UI/UX" aria-describedby="fui-r46"><div bis_skin_checked="1" style="aspect-ratio: 0.705 / 1; height: 14rem;"><img alt="Простое резюме для дизайнера и разработчика UI/UX" class="___2k7zy00 f1kle4es f1aehjj5 f1euv43f f15twtuk f1vgc2s3 fly5x3f f1l02sjl" src="./Word в Интернете — Microsoft 365_files/%D0%BF%D1%80%D0%BE%D1%81%D1%82%D0%BE%D0%B5-%D1%80%D0%B5%D0%B7%D1%8E%D0%BC%D0%B5-%D0%B4%D0%BB%D1%8F-%D0%B4%D0%B8%D0%B7%D0%B0%D0%B9%D0%BD%D0%B5%D1%80%D0%B0-%D0%B8-%D1%80%D0%B0%D0%B7%D1%80%D0%B.webp" loading="lazy"></div></button><div id="previewEditButtonsStyle" class="___1rtvkjo f1euv43f fjseox f1wswh21 f1e31b4d f1x0mjh4" bis_skin_checked="1"><div class="___1v9u7h9 f22iagw f6jr5hl f1czfa6m f1acs6jw f1e53v91 f8vbe74 fni485r f69kmt0 f1kd9ml8" bis_skin_checked="1"><button type="button" id="editTemplateButton-4d3043f2-443f-4762-af72-58798d2333ea" class="fui-Button r1f29ykk ___1y38iaw f1aapu2g fq1bxqj fgfkb25 fxxax6y f1043qnm f52wu7l f6i9fuv f1gu5o86 fnwkoal f1f0uunu fkw6ri2 f2a8moe f1eghkp3 f3nvo6x" aria-label="Изменить">Изменить</button></div></div></div><div class="___12vb27g fjseox" id="fui-r46" bis_skin_checked="1">Это простое резюме дизайнера и разработчика UI/UX выделится из пачки других. Этот шаблон резюме делает уникальное заявление о вас, вашем образовании и навыках в графическом цветовом блоке. Простой шаблон резюме дизайнера и разработчика UI/UX хорошо сочетается с простым шаблоном сопроводительного письма для резюме дизайнера и разработчика UI/UX. Шаблоны помогают создавать резюме и сопроводительные письма в едином стиле. Это шаблон со специальными возможностями.</div><div role="status" aria-live="polite" aria-atomic="true" class="___1tz03sw fyxfkj9 f1wch0ki fx1dtu3 f136euu9 f1a3p1vp f1mk8lai f1euv43f f1ff8sh1 fz5stix" bis_skin_checked="1"></div></div></div><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><div role="group" tabindex="0" id="card-13" aria-label="Аттестат, 14 из 20" aria-roledescription="slide" class="fui-CarouselCard ___1yqcwr5 fd9q35j f6dzj5z fy77jfu f14z66ap ftqa4ok fxh72wf f101ogj7 f1fgzgb1 f1ej52l8" data-tabster="{&quot;groupper&quot;:{&quot;tabbability&quot;:1},&quot;focusable&quot;:{&quot;isDefault&quot;:false}}" bis_skin_checked="1"><div class="___dvqppc0 f10pi13n fly5x3f f1gl81tg f22iagw f1vx9l62 fnkimw8 f70vs8p f1jh79k8 tile" bis_skin_checked="1"><div class="___cgrxe20 f10pi13n f22iagw f1vx9l62" bis_skin_checked="1"><button role="button" type="button" class="fui-Link ___1j59c1l f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fkhj508 figsok6 fja3aga f1mk8lai f1a3p1vp f1o700av f1iuv45f f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f10pi13n fmvc45e fm9niy f3nvo6x f1y74qym" data-carousel-tile-thumbnail="" aria-label="Аттестат" aria-describedby="fui-r48"><div bis_skin_checked="1" style="aspect-ratio: 1.41343 / 1; height: 14rem;"><img alt="Аттестат modern simple" class="___2k7zy00 f1kle4es f1aehjj5 f1euv43f f15twtuk f1vgc2s3 fly5x3f f1l02sjl" src="./Word в Интернете — Microsoft 365_files/%D0%B0%D1%82%D1%82%D0%B5%D1%81%D1%82%D0%B0%D1%82-modern-simple-0-1-f598e51b8b87.webp" loading="lazy"></div></button><div id="previewEditButtonsStyle" class="___1rtvkjo f1euv43f fjseox f1wswh21 f1e31b4d f1x0mjh4" bis_skin_checked="1"><div class="___1v9u7h9 f22iagw f6jr5hl f1czfa6m f1acs6jw f1e53v91 f8vbe74 fni485r f69kmt0 f1kd9ml8" bis_skin_checked="1"><button type="button" id="editTemplateButton-6f0730f7-af55-4625-a48f-ca4f32a6e4fa" class="fui-Button r1f29ykk ___1y38iaw f1aapu2g fq1bxqj fgfkb25 fxxax6y f1043qnm f52wu7l f6i9fuv f1gu5o86 fnwkoal f1f0uunu fkw6ri2 f2a8moe f1eghkp3 f3nvo6x" aria-label="Изменить">Изменить</button></div></div></div><div class="___12vb27g fjseox" id="fui-r48" bis_skin_checked="1">Этот празднично выглядящий и удобный в использовании шаблон диплома позволит вам поздравить учащихся с завершением учебной программы. В нем оставлено место для имени ученика, даты и названия учебного заведения. Он оформлен изящной рамкой и печатью. Средства Word позволяют легко адаптировать этот шаблон диплома за учебу к любой выпускной церемонии от детского сада до университета. Окончание учебного заведения — важное достижение, которое следует отметить. Поздравьте выпускника из числа ваших родных и близких с помощью персонализированного диплома, который можно сделать за несколько минут с помощью шаблона из Майкрософт. Этот шаблон поддерживает специальные возможности. </div><div role="status" aria-live="polite" aria-atomic="true" class="___1tz03sw fyxfkj9 f1wch0ki fx1dtu3 f136euu9 f1a3p1vp f1mk8lai f1euv43f f1ff8sh1 fz5stix" bis_skin_checked="1"></div></div></div><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><div role="group" tabindex="0" id="card-14" aria-label="Документ в стиле АПА, 15 из 20" aria-roledescription="slide" class="fui-CarouselCard ___1yqcwr5 fd9q35j f6dzj5z fy77jfu f14z66ap ftqa4ok fxh72wf f101ogj7 f1fgzgb1 f1ej52l8" data-tabster="{&quot;groupper&quot;:{&quot;tabbability&quot;:1},&quot;focusable&quot;:{&quot;isDefault&quot;:false}}" bis_skin_checked="1"><div class="___dvqppc0 f10pi13n fly5x3f f1gl81tg f22iagw f1vx9l62 fnkimw8 f70vs8p f1jh79k8 tile" bis_skin_checked="1"><div class="___cgrxe20 f10pi13n f22iagw f1vx9l62" bis_skin_checked="1"><button role="button" type="button" class="fui-Link ___1j59c1l f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fkhj508 figsok6 fja3aga f1mk8lai f1a3p1vp f1o700av f1iuv45f f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f10pi13n fmvc45e fm9niy f3nvo6x f1y74qym" data-carousel-tile-thumbnail="" aria-label="Документ в стиле АПА" aria-describedby="fui-r4a"><div bis_skin_checked="1" style="aspect-ratio: 0.705 / 1; height: 14r