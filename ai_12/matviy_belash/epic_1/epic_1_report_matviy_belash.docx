.bolt-button::-moz-focus-inner {
  border: 0;
}

/* Basic button colors */
.bolt-button {
  background-color: transparent;
  margin: 0;
}

.bolt-button:focus {
  z-index: 1;
}

.bolt-button.subtle:hover {
  background-color: var(--hover-background-color);
}

.bolt-button.subtle:active,
.bolt-button.active,
.bolt-button.subtle:active {
  background-color: var(--active-background-color);
