#include <iostream>
using namespace std;

int main() {
    long long n;
    cin >> n;

    long long sum = 0;
    for (long long i = 0; i < n; i++) {
        long long a;
        cin >> a;
        if (a > 0) {
            sum += a - 1;   // залишаємо у пачці одну штуку.
        }
    }

    cout << sum << endl;
    return 0;
}