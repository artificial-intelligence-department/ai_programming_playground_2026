#include <iostream> //відповідає за введення та виведення даних у консоль
#include <string>//відповідає за роботу з рядками
#include <cmath> //відповідає за математичні функції
#include <iomanip> //відповідає за форматування виводу (наприклад, округлення чисел до певної кількості знаків після коми через або вирівнання текксту)

using namespace std; //дозволяє використовувати стандартну бібліотеку без префікса std::

int main() {
    //змінні для зберігання даних про зарядну станцію
 //Змінна для текстової назви моделі
    string model;
    cout<<"Введіть модель станції:"<<endl;
    cin >>model; //введення даних користувачем
    if( model.size() > 31 ) {
        cout<<"Кількість символів не повинна перевищувати 31 "<<endl;
        return 1;}
    //Виведення данних у правильному вигляді за допомогою маніпуляторів з бібліотеки <iomanip>
    cout <<"Модель:" <<model<<endl;

    // Дробові числа подвійної точності для фізичних величин
    double capacity; //ємність батареї в ампер-годинах (Ah)
    double charge; //поточний заряд батареї в відсотках (%)
    double eff; //коефіцієнт корисної дії станції
    double power; //потужність зарядної станції в ватах (W)
    //ціле число для віку батареї в роках
    int age;

    cout<<"Паспортна ємність(Вт*год):"<<endl;
    cin >>capacity;
    cout<<"Рівень заряду:"<<endl;
    cin >>charge;
    cout<<"ККД інвентора:"<<endl;
    cin >>eff;
    cout<<"Потужність приладу (Вт):"<<endl;
    cin >>power;
    cout<<"Вік станції:"<<endl;
    cin >>age;

    if (capacity <=0||capacity >5000) {
        cout << "Помилка: Ємність батареї повинна бути додатнім числом та не перевищувати 5000." << endl;
       return 1; //повертаємо 1, що означає помилку
    }
    if (charge <0 || charge > 100) {
        cout << "Помилка: Поточний заряд батареї повинен бути в межах від 0 до 100%." << endl;
        return 1;
    }
    if (eff <=0 || eff > 100) {
        cout << "Помилка: Коефіцієнт корисної дії повинен бути в межах від 0 до 100%." << endl;
        return 1;
    }  
    if (power <=0) {
        cout << "Помилка: Потужність зарядної станції повинна бути додатнім числом." << endl;
        return 1;
    }   
    if (age <0 || age > 20) {
        cout << "Помилка: Вік батареї повинен бути в межах від 0 до 20 років." << endl;
        return 1;
    }
    //Вираховуємо фактичну ємність з урахуванням деградації акумулятора (2% на рік), Вт·год
    const double degradation_per_year = 0.02; // 0.02 — коефіцієнт щорічної втрати ємності (2% на рік)
    double c_eff= capacity * pow(1.0 - degradation_per_year, age); //фактична ємність батареї з урахуванням віку
   
    //Обчислення запасу енергії при поточному рівні заряду
    double E_stored = c_eff * (charge / 100.0);

    //Обчислення корисної енергії з урахуванням ККД
    double E_useful = E_stored * (eff / 100.0);

    //Обчислення втрат на перетворення
    double E_loss = E_stored - E_useful;

    //Обчислення повного часу роботи у годинах
    double T = E_useful / power;

    //Визначення кількості повних годин
    int h = static_cast<int>(T);

    //Обчислення кількості залишкових хвилин
    int m = static_cast<int>((T - h) * 60.0);

    
    // Налаштування дробового виводу: 1 знак після коми
    cout<< fixed << setprecision(1); 
    
    
    /*setprecision(N) — вказує кількість знаків після десяткової крапки. 
    Також є персистентним (залишається активним для всіх наступних змінних).*/

    /*fixed⁠ (у поєднанні з ⁠setprecision⁠) вказує консолі відображати дробові числа у 
    фіксованому форматі (звичайні десяткові дроби) та фіксує кількість знаків саме після крапки*/

    cout<<"Паспортна ємність:"<<capacity<<"Вт·год"<<endl;

    // Ціле число (вік) та фактична ємність
    cout<<"Вік батареї: "<< age << "р." <<endl;
    cout<<"Фактична ємність:"<<c_eff<<"Вт·год"<<endl;

    //Вивід заряду (0 знаків після коми)
    cout<<setprecision(0);
    cout<<"Рівень заряду: "<< charge << "%" <<endl;

    //Вивід ККД (2 знаки після коми)
    cout<<fixed<<setprecision(2);
    cout<<"ККД інвентора:"<<eff<< "%"<<endl;

    //Вивід енергії(1 знак після коми)
    cout<<setprecision(1);
    cout<<"Запас енергії:"<<E_stored<<"Вт·год"<<endl;
    cout<<"Корисна енергія: "<<E_useful<<"Вт·год"<<endl;
    cout<<"Втрати на перетворення:"<<E_loss<<"Вт·год"<<endl;

    //Вивід часу у годинах та хвилинах
    cout<<setprecision(2);
    cout<<"Час роботи:"<<T<<"год = " <<h<<"год"<<setw(2)<<setfill('0')<<m<<"хв"<<endl;




    return 0; //повертаємо 0, що означає успішне завершення програми
}